# ========================
# ENVIRONMENT & SECRETS
# ========================
# The .env file contains database passwords, JWT secrets, API keys
# If this gets committed, your entire system is compromised
.env
.env.*
!.env.example

# ========================
# PYTHON
# ========================
# __pycache__ = Python's compiled bytecode cache (auto-generated)
# .pyc files = individual compiled Python files
# These are machine-specific and regenerated automatically
__pycache__/
*.pyc
*.pyo

# Virtual environment (if anyone uses local venv for IDE support)
.venv/
venv/

# ========================
# NODE.JS (Frontend - Sufiyan's territory)
# ========================
# node_modules contains ALL downloaded npm packages
# Can be 500MB+ and is fully regenerated by 'npm install'
node_modules/

# ========================
# ML MODEL WEIGHTS
# ========================
# Trained model files are large (50-200MB)
# These are tracked separately, not in Git
*.h5
*.tflite
*.pt
*.onnx
backend/app/ml/models/

# ========================
# DOCKER
# ========================
# Docker volume data (database files, Redis dumps, MinIO storage)
# This is runtime data, not source code
docker-volumes/

# ========================
# IDE / EDITOR
# ========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ========================
# BUILD ARTIFACTS
# ========================
# Frontend production build output
frontend/dist/

# ========================
# LOGS
# ========================
*.log

# ========================
# TESTING
# ========================
.coverage
htmlcov/
.pytest_cache/

# ========================
# Project-Docs
# ========================
#/Ai-Use-Guidelines/
#/Project-Docs/

# ========================
# GRAVITAS
# ========================
.agents
.claude
/skills-lock.json

# ADDITIONAL
*.py[cod]
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
.vite/
npm-debug.log*
*.pem
*.key
*.keras
*.ckpt
*.npy
postgres_data/
redis_data/
minio_data/
*.local
uploads/
tmp/
