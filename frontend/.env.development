# Real backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Controls the dev-only mock API adapter in 'npm run dev'.
# Set to 'false' to communicate with the real backend running locally.
# Setting this to 'true' brings the dev mock API back for offline testing.
VITE_USE_MOCK_API=false
VITE_MOCK_API_DELAY_MS=400
